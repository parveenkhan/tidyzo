PORT=8443
NODE_ENV=development

# Use long random values outside this demo. Production refuses the dev defaults.
JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-different-long-random-secret

# Returns the OTP in the API response so the assignment can be demoed without an SMS vendor.
# Forced off when NODE_ENV=production.
ALLOW_DEBUG_OTP=true

# Absolute or relative path to a Firebase service account JSON.
# Leave empty to keep notifications in the customer inbox and as local device alerts.
FIREBASE_SERVICE_ACCOUNT_PATH=

SSL_KEY=../certs/key.pem
SSL_CERT=../certs/cert.pem
DB_PATH=./data/tidyzo.db
